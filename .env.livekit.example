# SFU media URL. Do not put the API secret in any EXPO_PUBLIC_* variable.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_server_only_key
LIVEKIT_API_SECRET=replace_with_a_long_private_secret

# Backend demo server. Use trusted HTTPS before connecting from real devices.
HOST=127.0.0.1
PORT=8787
# TUTTT_TLS_CERT=/absolute/path/to/cert.pem
# TUTTT_TLS_KEY=/absolute/path/to/key.pem

# Optional: bounded timeout for each SFU administration RPC (1..30000 ms).
# Default 8000; timeout means remote outcome UNKNOWN, not successful revocation.
# TUTTT_SFU_RPC_TIMEOUT_MS=8000
