# Public location of YOUR development API, reachable from the phone.
# Do not use localhost with a physical phone. Never put LiveKit API secrets here.
# For iOS/Android, HTTPS test staging is preferable to local HTTP.
EXPO_PUBLIC_TUTTT_API_URL=https://your-tuttt-test-api.example.com

# Optional, NON-SECRET app IDs for Android/iOS native development builds.
# Replace with identifiers belonging to your app; app.json keeps preview placeholders.
# Set these in your shell or EAS environment before a real native build.
# TUTTT_ANDROID_APPLICATION_ID=com.yourcompany.tuttt
# TUTTT_IOS_BUNDLE_ID=com.yourcompany.tuttt
